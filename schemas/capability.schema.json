{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aj.local/schemas/capability.schema.json",
  "title": "AJ capability declaration",
  "type": "object",
  "required": ["capability_id", "name", "owner_agent", "risk_level"],
  "additionalProperties": false,
  "properties": {
    "capability_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "owner_agent": { "enum": ["AJ", "JARVIS", "HELIX", "HERMES"] },
    "execution_adapter": { "type": "string" },
    "required_permissions": { "type": "array", "items": { "type": "string" } },
    "risk_level": { "type": "integer", "minimum": 0, "maximum": 4 },
    "availability": { "enum": ["available", "degraded", "unavailable", "unknown"] },
    "verification_status": {
      "enum": ["verified", "implemented_unverified", "partial", "experimental", "broken", "stub", "planned", "unknown"]
    },
    "supported_inputs": { "type": "array", "items": { "type": "string" } },
    "supported_outputs": { "type": "array", "items": { "type": "string" } },
    "side_effects": { "type": "array", "items": { "type": "string" } },
    "forbidden": { "type": "boolean" },
    "source": { "type": "string" },
    "notes": { "type": "string" }
  }
}
